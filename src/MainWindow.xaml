<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="六级词汇" Width="960" Height="760" MinWidth="760" MinHeight="560" Background="#FAFBFD" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="14" Foreground="#202B3C" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="15,8"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DAE1EA"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#F0F4FA"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#396BDD"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#E7EEFD"/><Setter Property="Foreground" Value="#295AB6"/><Setter Property="BorderBrush" Value="#CCD9F3"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="BorderBrush" Value="#DAE1EA"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,6"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="CheckBox"><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Margin" Value="8,0,16,0"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemFrame" Background="White" BorderBrush="#EDF0F5" BorderThickness="0,0,0,1"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemFrame" Property="Background" Value="#F1F5FD"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <DataTemplate x:Key="WordTemplate">
   <Grid Margin="20,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0" Margin="0,0,14,0">
     <Button Tag="expand" BorderThickness="0" Background="Transparent" Padding="4,8" Margin="0" HorizontalContentAlignment="Left" AutomationProperties.Name="{Binding English}">
      <StackPanel><TextBlock Text="{Binding English}" TextWrapping="Wrap" FontFamily="Segoe UI" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="{Binding Meaning}" Visibility="{Binding MeaningVisibility}" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#4A576D"/><TextBlock Text="暂无例句，可在导入词库中补充。" Visibility="{Binding MissingVisibility}" Margin="0,12,0,0" Foreground="#728098" FontSize="13"/></StackPanel>
     </Button>
     <DockPanel Visibility="{Binding ExampleVisibility}" Margin="4,12,0,6"><Button DockPanel.Dock="Right" Tag="example" Content="朗读例句" FontSize="12" Padding="10,5" Margin="12,0,0,0" VerticalAlignment="Top"/><StackPanel><TextBlock Text="{Binding ExampleEnglish}" TextWrapping="Wrap" FontFamily="Segoe UI" FontSize="15" Foreground="#4A576D"/><TextBlock Text="{Binding ExampleChinese}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#728098" FontSize="13"/></StackPanel></DockPanel>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,8,0,0"><Button Tag="speak" Content="发音" Padding="10,6" ToolTip="播放美式英语发音"/><Button Tag="master" Content="熟词" Padding="10,6" ToolTip="移至已掌握词汇"/><Button Tag="favorite" Content="{Binding FavoriteLabel}" Padding="12,6" Margin="0" ToolTip="加入或取消默认收藏" AutomationProperties.Name="默认收藏"/></StackPanel>
   </Grid>
  </DataTemplate>
 </Window.Resources>
 <Grid Margin="30,24,30,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Grid.Row="0" Margin="0,0,0,22"><StackPanel DockPanel.Dock="Left"><TextBlock Text="六级词汇" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="专注于眼前的一个词" FontSize="12" Foreground="#79869A" Margin="0,4,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="StudyNav" Tag="nav-study" Content="背诵" Style="{StaticResource Primary}"/><Button x:Name="QuizNav" Tag="nav-quiz" Content="默写"/><Button x:Name="BooksNav" Tag="nav-books" Content="单词本"/><Button x:Name="MoreNav" Content="更多" Margin="0"/></StackPanel></DockPanel>
  <ContentControl Grid.Row="1" x:Name="PageHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
  <TextBlock Grid.Row="2" x:Name="Status" Text="所有学习记录保存在本机" Foreground="#79869A" FontSize="12" Margin="0,14,0,0" TextWrapping="Wrap"/>
 </Grid>
</Window>
